{
  "name": "yugioh-duel-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "游戏王 LOCR 开盒与收藏模拟器",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "cards:generate": "node scripts/generate-card-data.mjs",
    "cards:check": "node scripts/generate-card-data.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:assets": "node tests/blender-assets.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test:cards:desktop": "node tests/card-desktop.mjs",
    "test:preservation": "node tests/layout-preservation.mjs",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.css\" \"scripts/*.mjs\" \"tests/helpers/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.js\" \"src/**/*.css\" \"scripts/*.mjs\" \"tests/helpers/*.mjs\"",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "resedit": "3.1.0",
    "sharp": "0.35.5"
  }
}
